# Runtime configuration
NODE_ENV=development
LOG_LEVEL=info

# API binds to loopback by default for local development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Browser-safe web configuration (never place secrets in VITE_* variables)
VITE_API_BASE_URL=http://localhost:3001

# Local development services
MONGODB_URI=mongodb://127.0.0.1:27017/personal_agent?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

# JWT signing secrets: generate independent random values before starting the API.
# These values are intentionally blank here and are never Vite/browser variables.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=personal-agent
JWT_AUDIENCE=personal-agent-api
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=1209600
# Refresh-cookie settings (local HTTP is restricted to loopback).
AUTH_COOKIE_NAME=pa_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict
# Bounded auth attempt limits; no permanent account lockout.
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REFRESH_RATE_LIMIT_MAX=30
# Durable outbox/queue worker settings.
BULLMQ_TASK_QUEUE_NAME=task-execution
BULLMQ_WORKER_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
TASK_DEFAULT_TIMEOUT_MS=10000

# Optional Phase 2 model provider. Leave all three empty to disable AI.
# Set a currently supported model identifier for the provider/project you use.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# Conservative server-side agent budgets. Cost remains UNKNOWN unless pricing is configured and verified.
AGENT_MAX_STEPS=8
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_REPEATED_ACTIONS=2
AGENT_MAX_TOTAL_TOKENS=8000
AGENT_MAX_OUTPUT_TOKENS=1000
